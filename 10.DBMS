// Step 3: Display inserted records

db.Employee.find().forEach(printjson)

// OP:
// Displays all 5 employee records



// Step 4:
// Find total salary of employees whose salary >60000 grouped by company

db.Employee.aggregate([
{$match:{Salary:{$gt:60000}}},
{$group:{
_id:"$CompanyName",
TotalSalary:{$sum:"$Salary"}
}}
]).forEach(printjson)

// OP:
// {
// _id:'TCS',
// TotalSalary:150000
// }
// {
// _id:'Wipro',
// TotalSalary:65000
// }
// {
// _id:'Infosys',
// TotalSalary:90000
// }



// Step 5:
// Return Max and Min salary for each company

db.Employee.aggregate([
{$group:{
_id:"$CompanyName",
MaxSalary:{$max:"$Salary"},
MinSalary:{$min:"$Salary"}
}}
]).forEach(printjson)

// OP:
// {
// _id:'TCS',
// MaxSalary:80000,
// MinSalary:70000
// }
// {
// _id:'Infosys',
// MaxSalary:90000,
// MinSalary:50000
// }
// {
// _id:'Wipro',
// MaxSalary:65000,
// MinSalary:65000
// }



// Step 6:
// Calculate total salary by company and store output in new collection

db.Employee.aggregate([
{$group:{
_id:"$CompanyName",
TotalSalary:{$sum:"$Salary"}
}},
{$out:"CompanySalary"}
])

// OP:
// Operation completed successfully



// Step 7:
// Display new collection data

db.CompanySalary.find().forEach(printjson)

// OP:
// {
// _id:'TCS',
// TotalSalary:150000
// }
// {
// _id:'Infosys',
// TotalSalary:140000
// }
// {
