DELIMITER //

CREATE TRIGGER salary_validation
BEFORE INSERT ON Employees2
FOR EACH ROW
BEGIN
    IF NEW.salary <= 0 THEN
        SIGNAL SQLSTATE '45000'
        SET MESSAGE_TEXT='Invalid Salary';
    END IF;
END//

DELIMITER ;

DELIMITER //

CREATE TRIGGER salary_update_validation
BEFORE UPDATE ON Employees2
FOR EACH ROW
BEGIN
    IF NEW.salary <= 0 THEN
        SIGNAL SQLSTATE '45000'
        SET MESSAGE_TEXT='Invalid Salary';
    END IF;
END//

DELIMITER ;

DELIMITER //

CREATE TRIGGER prevent_delete
BEFORE DELETE ON Employees2
FOR EACH ROW
BEGIN
    IF OLD.salary > 100000 THEN
        SIGNAL SQLSTATE '45000'
        SET MESSAGE_TEXT='Cannot delete high salary employee';
    END IF;
END//

DELIMITER ;

